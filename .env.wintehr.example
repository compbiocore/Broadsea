# Overlay for: docker compose --env-file .env --env-file .env.wintehr ...
CDM_VERSION="5.4"
CDM_SOURCE_NAME="WintEHR Synthetic FHIR OMOP"
CDM_DATABASE_SCHEMA="wintehr_cdm"
RESULTS_DATABASE_SCHEMA="wintehr_results"
VOCAB_DATABASE_SCHEMA="omop_vocab"
SCRATCH_DATABASE_SCHEMA="wintehr_scratch"
TEMP_EMULATION_SCHEMA="wintehr_temp"

# The currently pinned Achilles/ParallelLogger combination has an upstream
# multi-threaded performance-log parsing failure after its SQL work completes.
# Single-thread mode is reliable and is the supported WintEHR default.
ACHILLES_NUM_THREADS="1"
